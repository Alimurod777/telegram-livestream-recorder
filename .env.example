# Copy this file to .env. Never commit .env or session strings.
# Required Telegram credentials: my.telegram.org/apps and @BotFather.
API_ID=0
API_HASH=
BOT_TOKEN=

# Diagnostics: channel/group first, owner private bot chat on delivery failure.
# Bot must be able to post to the channel/group; owner must have started the bot.
OWNER_ID=0
LOG_CHANNEL_ID=0
# Optional compatibility aliases, used when LOG_CHANNEL_ID is 0.
LOGS_ID=0
LOG_EXCEPTION=0
LOG_DEDUP_SECONDS=120

# Optional required subscription. Bot must be able to inspect channel members.
# SUBSCRIBE_CHANNEL accepts a numeric -100... ID or @username.
FORCE_SUB_ENABLED=false
SUBSCRIBE_CHANNEL=0
# Public channel URL or private invitation URL for the join button.
SUBSCRIBE_CHANNEL_URL=

# Bot API transport. Public API upload limit is about 50 MB.
BOT_API_BASE_URL=https://api.telegram.org
POLLING_TIMEOUT=5
POLLING_HTTP_TIMEOUT=15
# For a local Bot API server, set the base URL and e.g. a 1900000000 upload limit.
BOT_API_UPLOAD_LIMIT=49000000
# Bot API fallback chunk size is clamped to BOT_API_UPLOAD_LIMIT.
RECORDING_CHUNK_BYTES=1850000000

# Prefer MTProto for large recordings; Bot API remains the last fallback.
USE_USERBOT_UPLOAD=1
USERBOT_UPLOAD_LIMIT=1990000000
SEGMENT_ROTATE_BYTES=1970000000
# Maximum per-recording duration: 1..14400 seconds (up to four hours).
MAX_RECORDING_SECONDS=14400
MIN_FREE_DISK_BYTES=2000000000

# Native source dimensions are preserved. These control encoder quality.
VIDEO_SOURCE_STALE_SECONDS=2.0
VIDEO_ENCODER_PRESET=veryfast
VIDEO_CRF=18
VIDEO_QUEUE_FRAMES=12
AUDIO_BITRATE=192k
AUDIO_NORMALIZE=0

# Primary account session persistence: optional MongoDB + local fallback.
# Leave MONGO_URI empty for local storage. DB_URI is a legacy alias.
MONGO_URI=
DB_URI=
MONGO_DATABASE=telegram_livestream_recorder
SESSION_DIR=./sessions

# Account capacity is fixed in code: one Telegram account per active livestream.
# MAX_RECORDINGS_PER_ACCOUNT is not an environment override.
# One bot user can use multiple distinct owned accounts for parallel recordings.
# Owner-only /maintenance and /logchannel settings persist in SQLite and override
# these startup defaults. Conversation forwards exclude owner and login secrets.
MAINTENANCE_MODE=false
CHAT_LOG_CHANNEL_ID=
